{
  "manifest_version": 3,
  "name": "Job Form Autofill - Vishnu",
  "version": "1.0.0",
  "description": "Fills job application forms from your saved profile. Never fills passwords, OTPs, or consent checkboxes.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Form Autofill"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["profile.js", "fill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
